rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function member(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    function teacher(classId) {
      return member(classId)
        && get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.role == "teacher";
    }

    function subjectMember(classId, subjectId) {
      return member(classId)
        && get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.subjectIds.hasAny([subjectId]);
    }

    match /pendingRegistrations/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.uid == userId
        && request.resource.data.role == "student"
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "uid", "role", "name", "femisId", "contactEmail", "status", "requestedAt", "updatedAt"
        ]);
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow update: if admin()
        || (signedIn()
          && request.auth.uid == userId
          && resource.data.status == "pending"
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == "student"
          && request.resource.data.status == "pending"
          && request.resource.data.keys().hasOnly([
            "uid", "role", "name", "femisId", "contactEmail", "status", "requestedAt", "updatedAt"
          ]));
      allow delete: if admin();
    }

    match /users/{userId} {
      allow read: if admin()
        || (signedIn() && request.auth.uid == userId)
        || (resource.data.role == "student" && teacher(resource.data.classId));
      allow create, update, delete: if admin();
    }

    match /classes/{classId} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin()
        || (teacher(classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["termStartDates"]));

      match /members/{userId} {
        allow read: if admin() || (signedIn() && request.auth.uid == userId);
        allow create, update, delete: if admin();
      }
    }

    match /materials/{materialId} {
      allow read: if admin()
        || (teacher(resource.data.classId) && resource.data.teacherUid == request.auth.uid)
        || (subjectMember(resource.data.classId, resource.data.subjectId)
          && resource.data.availableAt <= request.time);
      allow create: if signedIn()
        && teacher(request.resource.data.classId)
        && request.resource.data.teacherUid == request.auth.uid
        && subjectMember(request.resource.data.classId, request.resource.data.subjectId);
      allow update: if admin()
        || (teacher(resource.data.classId)
          && resource.data.teacherUid == request.auth.uid
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if admin()
        || (teacher(resource.data.classId) && resource.data.teacherUid == request.auth.uid);
    }

    match /liveClasses/{liveClassId} {
      allow read: if admin()
        || (teacher(resource.data.classId) && resource.data.teacherUid == request.auth.uid)
        || subjectMember(resource.data.classId, resource.data.subjectId);
      allow create: if signedIn()
        && teacher(request.resource.data.classId)
        && request.resource.data.teacherUid == request.auth.uid
        && subjectMember(request.resource.data.classId, request.resource.data.subjectId);
      allow update: if admin()
        || (teacher(resource.data.classId)
          && resource.data.teacherUid == request.auth.uid
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if admin()
        || (teacher(resource.data.classId) && resource.data.teacherUid == request.auth.uid);
    }
  }
}
